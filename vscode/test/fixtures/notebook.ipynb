   "source": [
    "from qiskit import QuantumCircuit\n",
    "from qiskit.primitives import StatevectorSampler\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "qc = QuantumCircuit(2)\n",
    "qc.measure_all()\n",
    "res = StatevectorSampler().run([qc]).result()\n",
    "counts = res.get_counts()\n"
   ]
  }
